VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Site origin for link-preview (og:) tags in index.html, no trailing slash.
# Set to the real domain for production builds, e.g. https://realmwar.example
VITE_PUBLIC_URL=http://localhost:5173

# Chat is off by default (no moderation yet). Enable here AND in server .env.
# VITE_CHAT_ENABLED=true
