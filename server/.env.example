DATABASE_URL=postgresql://postgres:password@localhost:5432/realmwar
# Generate real secrets with: openssl rand -base64 32
# (production refuses to boot with placeholders)
JWT_SECRET=change_this_to_a_random_secret
ADMIN_SECRET=change_this_to_a_random_secret
PORT=3001

# MODE controls pacing: dev (fast, generous economy - default), test (half dev
# speed, for rapid manual testing without the economy running away between
# sessions), or prod (real pacing - also enables boot-time config checks
# below, so set these before flipping to prod).
# MODE=dev

# ─── Production only (MODE=prod) ────────────────────────────────────────────────
# CLIENT_ORIGIN=https://yourdomain.com   # comma-separated allowed CORS origins
# TRUST_PROXY=1                # hops to trust when behind nginx/Cloudflare (rate-limit keying)

# Chat is off by default (no moderation yet). Enable here AND in client .env.
# CHAT_ENABLED=true

# Web push - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Kill switch for push notifications (in-app bell/Dispatches still work either way)
# NOTIFICATIONS_ENABLED=false
