# Copy to .env and fill in real values before `docker compose up`.
# Generate secrets with: openssl rand -base64 32

# Postgres
POSTGRES_DB=realmwar
POSTGRES_USER=realmwar
POSTGRES_PASSWORD=

# Backend
JWT_SECRET=
ADMIN_SECRET=
MODE=prod
CLIENT_ORIGIN=https://hexnation.app
TRUST_PROXY=1
# CHAT_ENABLED=true
# NOTIFICATIONS_ENABLED=false

# Web push (optional) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@hexnation.app

# Frontend (baked into the JS bundle at build time)
VITE_API_URL=https://hexnation.app
VITE_SOCKET_URL=https://hexnation.app
VITE_PUBLIC_URL=https://hexnation.app
VITE_CONTACT_EMAIL=privacy@hexnation.app
# VITE_CHAT_ENABLED=true

# Host port overrides (defaults avoid colliding with planner's 5432/5433/80/8080/8180/8081)
# POSTGRES_HOST_PORT=5434
# BACKEND_HOST_PORT=8481
# FRONTEND_HOST_PORT=8480

# Set by CI when pulling a specific pushed tag; defaults to latest
# IMAGE_TAG=latest
